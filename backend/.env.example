# URL de connexion PostgreSQL (version 17 recommandée)
DATABASE_URL=postgresql://postgres:password@localhost:5432/misisa_db

# Clé secrète pour la signature des jetons JWT
JWT_SECRET=generer-une-cle-secrete-tres-longue-et-aleatoire-pour-la-prod

# Clé de chiffrement réversible (Fernet) pour les données sensibles (ex: filiation)
ENCRYPTION_KEY=generer-une-autre-cle-secrete-aleatoire-2026

# Configuration Cloudinary (Stockage et gestion des photos)
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret
