# ==============================================================================
# CONFIGURATION GLOBALE MISISA - PRODUCTION / DOCKER COMPOSE
# ==============================================================================

# Ports d'exposition sur l'hôte VPS
FRONTEND_PORT=80
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# Base de Données PostgreSQL 17
# ------------------------------------------------------------------------------
POSTGRES_DB=misisa_db
POSTGRES_USER=misisa_user
POSTGRES_PASSWORD=definir_un_mot_de_passe_robuste_ici_123456!

# ------------------------------------------------------------------------------
# Sécurité & Chiffrement Backend
# ------------------------------------------------------------------------------
# Clé secrète pour signer les JWT (ex: générer avec: openssl rand -hex 32)
JWT_SECRET=generer_une_cle_secrete_jwt_robuste_et_longue_ici

# Clé de chiffrement réversible (Fernet) pour les données sensibles (ex: filiation)
ENCRYPTION_KEY=generer_une_cle_chiffrement_fernet_secrete_ici

# ------------------------------------------------------------------------------
# Stockage Photos Cloudinary
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret
CLOUDINARY_UPLOAD_PRESET=genealogie_unsigned

# ------------------------------------------------------------------------------
# Paramètres Frontend
# ------------------------------------------------------------------------------
# Laisser vide si l'application est servie via le Nginx du conteneur (recommandé).
# Renseigner uniquement si l'API est hébergée sur un domaine distinct (ex: https://api.mondomaine.com)
VITE_API_URL=
